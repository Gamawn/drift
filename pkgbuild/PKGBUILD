pkgname=drift
pkgver=0.3.2
pkgrel=1
pkgdesc='Endless YouTube Music radio from one of your playlists'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'mpv' 'yt-dlp')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/drift "$pkgdir/usr/bin/drift"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/drift.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/drift.svg"
  install -Dm644 "$startdir/drift.desktop" "$pkgdir/usr/share/applications/drift.desktop"
}
